# Конфиг списка серверов для PolySrv
#
# Этот файл — единственное место, где задаётся, откуда клиент берёт список
# серверов (официальные DC Telegram и т.д.). Кладёшь на любой CDN
# (jsDelivr, Cloudflare, свой S3/nginx) и меняешь адрес здесь.
#
# Формат файла: см. servers.json в корне репозитория (тот же файл кладётся
# в assets/ как офлайн-фолбэк).

# URL конфига (CDN). Поддерживается plain JSON.
SERVERS_CONFIG_URL=https://cdn.jsdelivr.net/gh/SandyTAP/polysrv-android@master/servers.json

# Таймаут загрузки конфига, мс
SERVERS_CONFIG_TIMEOUT_MS=5000

# Как долго кэшировать скачанный конфиг, мс (0 = до перезапуска приложения)
SERVERS_CONFIG_CACHE_TTL_MS=3600000
