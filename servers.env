# Конфиг списка серверов для PolySrv
#
# Этот файл — единственное место, где задаётся, откуда клиент берёт список
# серверов (официальные DC Telegram и т.д.). Кладёшь на любой CDN
# (jsDelivr, Cloudflare, свой S3/nginx, raw.githubusercontent) и меняешь адрес здесь.
#
# Формат файла: серверы лежат в переменной SERVERS_JSON (обычный JSON, одна строка).
# Клиент читает файл целиком и разбирает его как .env; если файл начинается с "{",
# он разбирается как обычный JSON.

# URL конфига (CDN). Поддерживается plain JSON или .env с переменной SERVERS_JSON.
SERVERS_CONFIG_URL=https://raw.githubusercontent.com/roon9e/polysrv-android/refs/heads/master/servers.env

# Таймаут загрузки конфига, мс
SERVERS_CONFIG_TIMEOUT_MS=5000

# Как долго кэшировать скачанный конфиг, мс (0 = до перезапуска приложения)
SERVERS_CONFIG_CACHE_TTL_MS=3600000

# Список серверов (адреса DC, RSA-ключи, имена).
SERVERS_JSON={"version":1,"updated":"2026-10-21","servers":[{"id":"telegram","name":"Telegram","description":"Official Telegram cloud. Sign in with your Telegram account.","isTelegram":true,"multiDc":true,"mainDcId":2,"rsaPublicKey":"-----BEGIN RSA PUBLIC KEY-----\nMIIBCgKCAQEA6LszBcC1LGzyr992NzE0ieY+BSaOW622Aa9Bd4ZHLl+TuFQ4lo4g\n5nKaMBwK/BIb9xUfg0Q29/2mgIR6Zr9krM7HjuIcCzFvDtr+L0GQjae9H0pRB2OO\n62cECs5HKhT5DZ98K33vmWiLowc621dQuwKWSQKjWf50XYFw42h21P2KXUGyp2y/\n+aEyZ+uVgLLQbRA1dEjSDZ2iGRy12Mk5gpYc397aYp438fsJoHIgJ2lgMv5h7WY9\nt6N/byY9Nw9p21Og3AoXSL2q/2IJ1WRUhebgAdGVMlV1fkuOQoEzR7EdpqtQD9Cs\n5+bfo3Nhmcyvk5ftB0WkJ9z6bNZ7yxrP8wIDAQAB\n-----END RSA PUBLIC KEY-----","rsaKeyFingerprint":-3414540481677951611,"dc":[{"id":1,"host":"149.154.175.50","port":443},{"id":2,"host":"149.154.167.51","port":443},{"id":3,"host":"149.154.175.100","port":443},{"id":4,"host":"149.154.167.91","port":443},{"id":5,"host":"149.154.171.5","port":443}]}]}
